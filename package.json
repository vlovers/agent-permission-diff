{
  "name": "rulewitness",
  "version": "0.2.0",
  "description": "Detect, explain, and test Claude Code permission changes across Git revisions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlovers/agent-permission-diff.git"
  },
  "homepage": "https://github.com/vlovers/agent-permission-diff#readme",
  "bugs": {
    "url": "https://github.com/vlovers/agent-permission-diff/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "rulewitness": "dist/cli.js",
    "agent-permission-diff": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:package": "node --test test/package-smoke.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude-code",
    "claude-permissions",
    "permission-diff",
    "ai-agent-security",
    "git-diff",
    "typescript",
    "cli",
    "policy-testing",
    "static-analysis"
  ]
}
