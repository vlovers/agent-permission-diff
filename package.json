{
  "name": "agent-permission-diff",
  "version": "0.1.0",
  "description": "Offline effective permission policy comparison for AI coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlovers/agent-permission-diff.git"
  },
  "homepage": "https://github.com/vlovers/agent-permission-diff#readme",
  "bugs": {
    "url": "https://github.com/vlovers/agent-permission-diff/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "agent-permission-diff": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:package": "node --test test/package-smoke.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
